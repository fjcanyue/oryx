# Maintainer: Walid Mahfoudh <walid.mahfoudh@gmail.com>
pkgname=oryx-editor-bin
pkgver=1.2.0
pkgrel=1
pkgdesc='Fast editor for markdown and code, reader for ebooks and comics'
arch=('x86_64')
url='https://github.com/wmahfoudh/oryx'
license=('GPL-3.0-only')
# gcc-libs ships the libgcc_s.so.1 the binary links; namcap calls it
# implicitly satisfied, it is listed all the same.
depends=('openssl' 'gcc-libs' 'glibc' 'hicolor-icon-theme')
makedepends=('librsvg')
provides=('oryx-editor')
# The command is oryx. The extra repository ships an unrelated oryx (a
# network sniffer) that installs the same /usr/bin/oryx.
conflicts=('oryx' 'oryx-editor')
# The release binary is shipped as built, already stripped, with no
# debug split to make from it.
options=('!strip' '!debug')
source=("$url/releases/download/v$pkgver/oryx-$pkgver-linux-$CARCH.tar.gz"
        "$pkgname-$pkgver.desktop::https://raw.githubusercontent.com/wmahfoudh/oryx/v$pkgver/packaging/linux/com.steerania.Oryx.desktop"
        "$pkgname-$pkgver.metainfo.xml::https://raw.githubusercontent.com/wmahfoudh/oryx/v$pkgver/packaging/linux/com.steerania.Oryx.metainfo.xml"
        "$pkgname-$pkgver.svg::https://raw.githubusercontent.com/wmahfoudh/oryx/v$pkgver/assets/icon/oryx.svg"
        "$pkgname-$pkgver.stage-linux.sh::https://raw.githubusercontent.com/wmahfoudh/oryx/v$pkgver/packaging/stage-linux.sh")
# Written by packaging/channels.sh once the release is published.
sha256sums=('b21acddfcbf8d95b92e0dc49440acfdb763973490a5ead2d04c185ffea6b858b'
            '0885c988e89e659d9429b8154a41b1310fb43115b7f1d209c1e4485a3d635193'
            'b975cc02f9370d34ac2a3046183c516512b1188815ed67c3a5581ac4710352ab'
            '4a18393ce9d317508b6002214d9b3cef677ddc5fa631d47ccf53daf9e7bb65e9'
            'aafa7be3fb4850bed38f395de4235d7c88d7b191ec33134c757148128008b625')

# The binary is the release build, made on Ubuntu 22.04 against glibc
# 2.35 and OpenSSL 3. The desktop files are laid out by the script the
# .deb, the .rpm, the AppImage and the source package share, placed here
# where it expects them.
prepare() {
    rm -rf tree
    mkdir -p tree/packaging/linux tree/assets/icon
    cp "$pkgname-$pkgver.desktop" tree/packaging/linux/com.steerania.Oryx.desktop
    cp "$pkgname-$pkgver.metainfo.xml" tree/packaging/linux/com.steerania.Oryx.metainfo.xml
    cp "$pkgname-$pkgver.svg" tree/assets/icon/oryx.svg
    cp "$pkgname-$pkgver.stage-linux.sh" tree/packaging/stage-linux.sh
}

package() {
    sh tree/packaging/stage-linux.sh oryx "$pkgdir/usr"
}
